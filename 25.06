    function User(name, age) {
        this.name = name;
        this.age = age;
}

    User.prototype.sayHello = function () {
        console.log("Привет, меня зовут " + this.name);
};

    User.prototype.isAdult = function () {
        return this.age >= 18;
};

    let user1 = new User("Иван", 20);
    let user2 = new User("Анна", 15);

    user1.sayHello();
    console.log("Совершеннолетний: " + user1.isAdult());

    user2.sayHello();
    console.log("Совершеннолетний: " + user2.isAdult());
